# Optional keys for live model calls. The offline demo does not need them.
#
# These programs read the process environment. They do not load this file.
# Copy a value into your shell when you want a live call, and unset it after.
# Do not commit a filled-in copy. .env is gitignored; this example is not.
#
# Triage tool choice (outside CI):
#   python agent.py --sample --fresh --real
# Runbook answers (outside CI):
#   python runbook_search.py --model-answer
XAI_API_KEY=

# Used only when you name that provider on a runbook answer.
OPENAI_API_KEY=
GOOGLE_API_KEY=
